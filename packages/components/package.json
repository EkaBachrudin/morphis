{
  "name": "@eka-morphis/components",
  "version": "0.1.0",
  "description": "All Morphis Web Components in one bundle",
  "license": "MIT",
  "author": "Morphis",
  "type": "module",
  "main": "./dist/morphis.js",
  "module": "./dist/morphis.js",
  "types": "./dist/types/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/morphis.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "**/*.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eka-morphis/morphis.git",
    "directory": "packages/components"
  },
  "dependencies": {
    "@eka-morphis/button": "^0.1.0",
    "@eka-morphis/card": "^0.1.0",
    "@eka-morphis/input": "^0.1.0",
    "@eka-morphis/other-offer": "^0.1.0",
    "@eka-morphis/select": "^0.1.0"
  }
}
