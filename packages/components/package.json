{
  "name": "@morphis/components",
  "version": "0.1.0",
  "description": "All Morphis Web Components in one bundle",
  "license": "MIT",
  "author": "Morphis",
  "type": "module",
  "main": "./dist/morphis.js",
  "module": "./dist/morphis.js",
  "types": "./dist/types/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/morphis.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "**/*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@morphis/button": "^0.1.0",
    "@morphis/card": "^0.1.0",
    "@morphis/input": "^0.1.0",
    "@morphis/other-offer": "^0.1.0",
    "@morphis/select": "^0.1.0"
  }
}
