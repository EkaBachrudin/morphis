    "directory": "packages/react"
  },
  "dependencies": {
    "@eka-morphis/button": "^0.1.0",
    "@eka-morphis/card": "^0.1.0",
    "@eka-morphis/input": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
