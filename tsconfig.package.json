{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@eka-morphis/other-offer": ["./packages/components/other-offer/dist/types/other-offer.d.ts", "./packages/components/other-offer/src/other-offer.ts"],
      "@eka-morphis/core": ["./packages/core/dist/index.d.ts", "./packages/core/src/index.ts"],
      "@eka-morphis/button": ["./packages/components/button/dist/types/button.d.ts", "./packages/components/button/src/button.ts"],
      "@eka-morphis/card": ["./packages/components/card/dist/types/card.d.ts", "./packages/components/card/src/card.ts"],
      "@eka-morphis/input": ["./packages/components/input/dist/types/input.d.ts", "./packages/components/input/src/input.ts"],
      "@eka-morphis/select": ["./packages/components/select/dist/types/select.d.ts", "./packages/components/select/src/select.ts"]
    }
  }
}
