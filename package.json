{
  "name": "morphis",
  "private": true,
  "description": "Morphis monorepo — framework-agnostic Web Components",
  "license": "MIT",
  "author": "Morphis",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/components/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf custom-elements.json downloads packages/*/dist packages/components/dist packages/components/*/dist",
    "build": "npm run clean && npm run build:tokens && npm run build:core && npm run build:components && npm run build:types && npm run build:cem && npm run build:export",
    "build:core": "npm run build -w @morphis/core",
    "build:tokens": "npm run build -w @morphis/tokens",
    "build:components": "node scripts/build-components.mjs",
    "build:downloads": "node scripts/build-downloads.mjs",
    "build:types": "node scripts/build-types.mjs",
    "build:cem": "node scripts/build-cem.mjs",
    "build:export": "node scripts/build-export.mjs",
    "gen": "node scripts/generate-component.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run build:cem",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "lint:styles": "eslint \"src/**/*.css\" \"packages/components/*/src/**/*.css\"",
    "audit:prod": "npm audit --omit=dev",
    "audit:ci": "npm audit --audit-level=critical",
    "storybook": "npm run build:tokens && npm run build:cem && npm run build:downloads && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && npm run build:cem && npm run build:downloads && storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/css": "^2.0.0",
    "@lit-labs/analyzer": "^0.14.0",
    "@lit-labs/gen-manifest": "^0.3.6",
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/web-components": "^10.0.0",
    "@storybook/web-components-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.0.0",
    "glob": "^13.0.0",
    "jsdom": "^30.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.43"
  },
  "customElements": "custom-elements.json",
  "allowScripts": {
    "esbuild": true
  }
}
