{
  "name": "@morphis/components",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Components by Morphis",
  "license": "MIT",
  "author": "Morphis",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "design-system",
    "framework-agnostic",
    "drupal",
    "twig",
    "react",
    "vue"
  ],
  "type": "module",
  "main": "./dist/morphis.js",
  "module": "./dist/morphis.js",
  "types": "./dist/types/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/morphis.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components/*": {
      "types": "./dist/types/components/*/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./markup/*": "./dist/markup/*.html",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.js",
    "**/*.css",
    "**/*.ts",
    "**/*.tsx"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf dist custom-elements.json",
    "build": "npm run clean && npm run build:tokens && npm run build:components && npm run build:types && npm run build:cem && npm run build:export",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:components": "node scripts/build-components.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:cem": "cem analyze",
    "build:export": "node scripts/build-export.mjs",
    "gen": "node scripts/generate-component.mjs",
    "dev": "npm run build:tokens && npm run build:cem && vite",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "cem analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "storybook": "npm run build:tokens && npm run build:cem && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && npm run build:cem && storybook build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/web-components": "^10.0.0",
    "@storybook/web-components-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.0",
    "jsdom": "^30.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.43"
  }
}
